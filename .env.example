# Base URL of the AxeTask API (the AXETASKS Express/Vercel backend).
# Defaults to production if unset — override for local dev with your
# machine's LAN IP (not localhost/127.0.0.1 — a physical device or emulator
# can't reach your computer's loopback address), e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
EXPO_PUBLIC_API_URL=https://axe-task.vercel.app
